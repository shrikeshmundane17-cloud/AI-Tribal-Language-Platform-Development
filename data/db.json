    {
      "id": "les_1",
      "teacherId": "usr_teacher_1",
      "teacherName": "Rajesh Soren",
      "title": "Basic Classroom Greetings",
      "subject": "General Knowledge",
      "sourceLanguage": "Hindi",
      "targetLanguage": "Santhali",
      "contentOriginal": "नमस्ते! आपका स्वागत है। शिक्षक को गुरु और छात्र को हड़ाम कहते हैं।",
      "contentTranslated": "Johar! Daram ape kana. Guru ar Hadam.",
      "script": "Ol Chiki / Roman",
      "createdAt": "2026-09-05T09:30:00.000Z"
    },
    {
      "id": "les_2",
      "teacherId": "usr_teacher_1",
      "teacherName": "Rajesh Soren",
      "title": "Tribal Flora & Sal Trees",
      "subject": "Environmental Studies",
      "sourceLanguage": "Hindi",
      "targetLanguage": "Mundari",
      "contentOriginal": "पेड़ और जंगल हमारी रक्षा करते हैं। नदी से हमें साफ़ पानी मिलता है।",
      "contentTranslated": "Hatu ar Bir abu-e banchaoa. Nadi khene Dak milawa.",
      "script": "Roman / Devanagari",
      "createdAt": "2026-09-06T11:00:00.000Z"
    },
    {
      "id": "les_3",
      "teacherId": "usr_teacher_1",
      "teacherName": "Rajesh Soren",
      "title": "Counting Numbers 1 to 5",
      "subject": "Mathematics",
      "sourceLanguage": "English",
      "targetLanguage": "Ho",
      "contentOriginal": "One, Two, Three, Four, Five.",
      "contentTranslated": "Mind, Bari, Peng, Puni, Mone.",
      "script": "Warang Citi / Roman",
      "createdAt": "2026-09-07T14:15:00.000Z"
    },
    {
      "id": "les_4",
      "teacherId": "usr_teacher_1",
      "teacherName": "Rajesh Soren",
      "title": "Water is Life (जल ही जीवन है)",
      "subject": "Science",
      "sourceLanguage": "Hindi",
      "targetLanguage": "Santhali",
      "contentOriginal": "पानी हमारे शरीर के लिए बहुत आवश्यक है। साफ़ पानी पीना चाहिए।",
      "contentTranslated": "Dak abu ar salaha. Sukun Dak u jom.",
      "script": "Ol Chiki",
      "createdAt": "2026-09-08T10:00:00.000Z"
    }
  ],
